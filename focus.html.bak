<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ATLAS APP · Focus Timer</title>
<link rel="stylesheet" href="style.css">
<style>
/* ═══════════════════════════════════════════
   FOCUS TIMER — FULL REDESIGN
═══════════════════════════════════════════ */
* { box-sizing: border-box; }

.focus-container { max-width: 560px; margin: 0 auto; padding: 0 0 80px; }

/* ── Intro screen ── */
.intro-wrap { padding: 14px 14px 24px; }
.intro-hero { text-align: center; padding: 10px 0; }
.intro-icon { font-size: 38px; margin-bottom: 6px; animation: focusFloat 3s ease-in-out infinite; }
@keyframes focusFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
.intro-title { font-size: 19px; font-weight: 900; color: var(--accent); }
.intro-sub { font-size: 11.5px; color: var(--text-secondary); margin-top: 3px; }
.premium-box {
  background: var(--accent-light); border: 1.5px solid var(--accent);
  border-radius: var(--radius); padding: 12px 14px; margin: 14px 0 10px;
}
.premium-box-title { font-size: 12px; font-weight: 800; color: var(--accent); margin-bottom: 8px; }
.feature-list { list-style: none; display: flex; flex-direction: column; gap: 5px; }
.feature-list li { font-size: 11.5px; color: var(--text); display: flex; gap: 6px; line-height: 1.4; }
.feature-list li::before { content:'✅'; flex-shrink:0; font-size:10px; }
.how-box { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; margin-bottom: 14px; }
.how-title { font-size: 11px; font-weight: 800; color: var(--text-secondary); margin-bottom: 8px; }
.how-step { font-size: 11.5px; color: var(--text); display: flex; gap: 6px; align-items: flex-start; line-height: 1.3; margin-bottom: 5px; }
.how-step-num {
  width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
  background: var(--accent-light); border: 1px solid var(--accent);
  color: var(--accent); font-size: 9px; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
}
.intro-start-btn {
  width: 100%; padding: 14px; background: var(--accent); border: none;
  border-radius: var(--radius); color: #fff; font-size: 15px; font-weight: 900;
  cursor: pointer; font-family: inherit; box-shadow: var(--shadow-md);
}
.intro-start-btn:active { transform: scale(.98); }

/* ── Timer screen ── */
.timer-screen { display: none; }
.timer-screen.show { display: block; }

/* ═══ HEADER TICKER ═══ */
.header-ticker {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-bottom: 1px solid var(--border);
  padding: 6px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  overflow: hidden;
}
.ticker-label { font-size: 9px; font-weight: 900; color: var(--accent); white-space: nowrap; flex-shrink: 0; letter-spacing: 1px; }
.ticker-track { flex: 1; overflow: hidden; position: relative; }
.ticker-inner {
  display: flex; gap: 16px;
  animation: tickerScroll 20s linear infinite;
  white-space: nowrap;
}
.ticker-inner:hover { animation-play-state: paused; }
@keyframes tickerScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.ticker-chip {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;
  flex-shrink: 0;
}
.tc-study { background: rgba(16,185,129,.15); color: #10B981; }
.tc-break { background: rgba(245,158,11,.15); color: #F59E0B; }
.tc-sleep { background: rgba(99,102,241,.15); color: #818CF8; }
.ticker-dot { width: 5px; height: 5px; border-radius: 50%; animation: focusBlink 1.2s ease-in-out infinite; }
.ticker-dot-g { background: #10B981; }
.ticker-dot-a { background: #F59E0B; }
.ticker-dot-p { background: #818CF8; }

/* USER NAME + BATCH in header area */
.user-header-box {
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  padding: 8px 14px;
  display: flex; align-items: center; justify-content: space-between;
}
.uhb-left { display: flex; align-items: center; gap: 8px; }
.uhb-avatar {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #818CF8);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 900; color: #fff; flex-shrink: 0;
  position: relative; overflow: hidden;
}
.uhb-avatar-glow {
  position: absolute; inset: 0; border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,.3), transparent);
  animation: avatarGlow 2s ease-in-out infinite alternate;
}
@keyframes avatarGlow {
  0% { opacity: 0.3; }
  100% { opacity: 0.8; }
}
.uhb-name { font-size: 13px; font-weight: 900; color: var(--text); }
.uhb-batch-pill {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: 12px;
  background: rgba(99,102,241,.15); border: 1px solid rgba(99,102,241,.3);
  font-size: 10px; font-weight: 800; color: #818CF8;
  position: relative; overflow: hidden;
}
.uhb-batch-pill::before {
  content: '';
  position: absolute; top: 0; left: -100%;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent);
  animation: batchShimmer 3s ease-in-out infinite;
}
@keyframes batchShimmer {
  0% { left: -100%; } 100% { left: 200%; }
}
.uhb-right { display: flex; align-items: center; gap: 6px; }
.history-btn {
  display: flex; align-items: center; gap: 4px;
  padding: 5px 10px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--card-bg); color: var(--text-secondary);
  font-size: 9px; font-weight: 800; cursor: pointer; font-family: inherit;
  white-space: nowrap;
}
.history-btn:hover { border-color: var(--accent); color: var(--accent); }

/* ═══ MOOD BUTTONS ═══ */
.mood-row {
  display: flex; gap: 6px; padding: 10px 14px 6px;
  position: relative; z-index: 2;
}
.mood-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  gap: 3px; padding: 8px 4px; border-radius: 12px; border: 1.5px solid transparent;
  cursor: pointer; font-family: inherit; font-size: 9px; font-weight: 900;
  letter-spacing: .3px; position: relative; overflow: hidden;
  transition: all .3s; color: #fff;
}
.mood-btn .mood-icon { font-size: 16px; }
.mood-btn .mood-label { font-size: 9px; font-weight: 800; }
.mood-btn .mood-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: rgba(255,255,255,.5);
  transition: all .3s;
}
.mood-btn.active .mood-dot { background: #fff; box-shadow: 0 0 6px rgba(255,255,255,.8); }

/* Pulse animation for active mood */
.mood-btn.active::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: 12px;
  animation: moodPulse 2s ease-in-out infinite;
}
@keyframes moodPulse {
  0%,100% { box-shadow: inset 0 0 0 0 rgba(255,255,255,.2); }
  50% { box-shadow: inset 0 0 20px 2px rgba(255,255,255,.1); }
}

/* Study Mood */
.mood-study {
  background: linear-gradient(135deg, #0f4c2a, #166534, #15803d);
  border-color: rgba(16,185,129,.4);
}
.mood-study.active {
  background: linear-gradient(135deg, #10B981, #059669, #047857);
  border-color: #10B981;
  box-shadow: 0 4px 16px rgba(16,185,129,.4);
  animation: moodGlow 2s ease-in-out infinite alternate;
}
@keyframes moodGlow {
  0% { box-shadow: 0 4px 16px rgba(16,185,129,.3); }
  100% { box-shadow: 0 4px 24px rgba(16,185,129,.6); }
}

/* Break Mood */
.mood-break {
  background: linear-gradient(135deg, #5c3a00, #92400e, #b45309);
  border-color: rgba(245,158,11,.3);
}
.mood-break.active {
  background: linear-gradient(135deg, #F59E0B, #D97706, #B45309);
  border-color: #F59E0B;
  box-shadow: 0 4px 16px rgba(245,158,11,.4);
  animation: breakGlow 2s ease-in-out infinite alternate;
}
@keyframes breakGlow {
  0% { box-shadow: 0 4px 16px rgba(245,158,11,.3); }
  100% { box-shadow: 0 4px 24px rgba(245,158,11,.6); }
}

/* Sleep Mood */
.mood-sleep {
  background: linear-gradient(135deg, #1e1b4b, #312e81, #3730a3);
  border-color: rgba(99,102,241,.3);
}
.mood-sleep.active {
  background: linear-gradient(135deg, #6366F1, #4F46E5, #4338CA);
  border-color: #6366F1;
  box-shadow: 0 4px 16px rgba(99,102,241,.4);
  animation: sleepGlow 2s ease-in-out infinite alternate;
}
@keyframes sleepGlow {
  0% { box-shadow: 0 4px 16px rgba(99,102,241,.3); }
  100% { box-shadow: 0 4px 24px rgba(99,102,241,.6); }
}

/* ═══ TIMER MAIN ═══ */
.timer-main {
  display: flex; flex-direction: column; align-items: center;
  padding: 16px 14px 8px; position: relative;
}

/* Timer Ring */
.timer-ring-wrap { position: relative; width: 180px; height: 180px; margin-bottom: 10px; }
.timer-svg { transform: rotate(-90deg); }
.t-track { fill:none; stroke:var(--border); stroke-width:10; }
.t-ring { fill:none; stroke:var(--accent); stroke-width:10; stroke-linecap:round; stroke-dasharray:534; stroke-dashoffset:534; transition: stroke-dashoffset .9s linear, stroke .4s; }
.timer-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; }
.t-time-row { display: flex; align-items: baseline; gap: 2px; }
.t-hours { font-size: 28px; font-weight: 900; color: var(--text); font-family: 'Inter', monospace; letter-spacing: 1px; }
.t-colon { font-size: 24px; font-weight: 900; color: var(--text-secondary); animation: colonBlink 1s step-end infinite; }
@keyframes colonBlink { 0%,100%{opacity:1} 50%{opacity:0.2} }
.t-mins { font-size: 28px; font-weight: 900; color: var(--text); font-family: 'Inter', monospace; letter-spacing: 1px; }
.t-colon2 { font-size: 20px; font-weight: 900; color: var(--text-secondary); opacity: .6; }
.t-secs { font-size: 18px; font-weight: 800; color: var(--text-secondary); font-family: 'Inter', monospace; }
.t-label { font-size: 10px; color: var(--text-secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
.t-mood-badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 8px; border-radius: 10px; font-size: 9px; font-weight: 800;
  margin-top: 2px;
}
.badge-study { background: rgba(16,185,129,.15); color: #10B981; }
.badge-break { background: rgba(245,158,11,.15); color: #F59E0B; }
.badge-sleep { background: rgba(99,102,241,.15); color: #818CF8; }

/* Control Buttons */
.timer-controls {
  display: flex; gap: 10px; padding: 0 14px 10px;
}
.ctrl-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px;
  padding: 11px 8px; border-radius: 12px; border: 1.5px solid var(--border);
  background: var(--card-bg); color: var(--text); font-size: 11px; font-weight: 800;
  cursor: pointer; font-family: inherit; transition: all .2s;
}
.ctrl-btn:active { transform: scale(.96); }
.ctrl-pause { border-color: rgba(245,158,11,.4); color: #F59E0B; }
.ctrl-resume { border-color: rgba(16,185,129,.4); color: #10B981; background: rgba(16,185,129,.08); }
.ctrl-stop { border-color: rgba(239,68,68,.4); color: #EF4444; }
.ctrl-btn:disabled { opacity: .35; cursor: not-allowed; }

/* TOP FOCUSED BOX */
.top-focused-box {
  margin: 6px 14px 4px;
  padding: 10px 12px;
  background: linear-gradient(135deg, rgba(245,158,11,.08), rgba(245,158,11,.04));
  border: 1.5px solid rgba(245,158,11,.3);
  border-radius: 12px;
  display: flex; align-items: center; gap: 10px;
}
.tf-trophy { font-size: 22px; flex-shrink: 0; }
.tf-info { flex: 1; min-width: 0; }
.tf-label { font-size: 9px; font-weight: 800; color: #F59E0B; letter-spacing: .5px; }
.tf-name { font-size: 14px; font-weight: 900; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tf-meta { font-size: 10px; color: var(--text-secondary); }
.tf-stats { text-align: right; flex-shrink: 0; }
.tf-time { font-size: 16px; font-weight: 900; color: #F59E0B; }
.tf-premium { font-size: 8px; padding: 1px 5px; border-radius: 6px; background: linear-gradient(90deg, #F59E0B, #FBBF24); color: #000; font-weight: 900; }

/* ═══ LIVE STATS ROW ═══ */
.live-stats-row {
  display: flex; gap: 6px; padding: 0 14px 6px;
}
.lsr-card {
  flex: 1; padding: 8px 10px; background: var(--card-bg);
  border: 1px solid var(--border); border-radius: 10px; text-align: center;
}
.lsr-val { font-size: 20px; font-weight: 900; }
.lsr-val.green { color: #10B981; }
.lsr-val.amber { color: #F59E0B; }
.lsr-val.purple { color: #818CF8; }
.lsr-lbl { font-size: 9px; color: var(--text-secondary); font-weight: 600; margin-top: 1px; }

/* Break People List */
.break-people-box {
  margin: 0 14px 6px;
  padding: 8px 12px;
  background: rgba(245,158,11,.06);
  border: 1px solid rgba(245,158,11,.2);
  border-radius: 10px;
  display: none;
}
.break-people-box.show { display: block; }
.bpb-title { font-size: 10px; font-weight: 800; color: #F59E0B; margin-bottom: 5px; }
.bpb-list { display: flex; flex-wrap: wrap; gap: 4px; }
.bpb-chip {
  display: inline-flex; align-items: center; gap: 3px;
  padding: 2px 8px; border-radius: 10px;
  background: rgba(245,158,11,.12); font-size: 10px; font-weight: 700; color: #F59E0B;
}
.sleep-people-box {
  margin: 0 14px 6px;
  padding: 8px 12px;
  background: rgba(99,102,241,.06);
  border: 1px solid rgba(99,102,241,.2);
  border-radius: 10px;
  display: none;
}
.sleep-people-box.show { display: block; }
.spb-title { font-size: 10px; font-weight: 800; color: #818CF8; margin-bottom: 5px; }
.spb-list { display: flex; flex-wrap: wrap; gap: 4px; }
.spb-chip {
  display: inline-flex; align-items: center; gap: 3px;
  padding: 2px 8px; border-radius: 10px;
  background: rgba(99,102,241,.12); font-size: 10px; font-weight: 700; color: #818CF8;
}

/* ═══ LEADERBOARD CATEGORIES ═══ */
.leaderboard-section { padding: 6px 14px; }
.lb-title { font-size: 13px; font-weight: 900; color: var(--text); margin-bottom: 8px; }

.lb-period-row {
  display: flex; gap: 6px; margin-bottom: 6px; flex-wrap: wrap;
}
.lb-period-row2 {
  display: flex; gap: 6px; margin-bottom: 8px;
}
.period-btn {
  flex: 1; padding: 7px 6px; border-radius: 10px; border: 1.5px solid var(--border);
  background: var(--card-bg); color: var(--text-secondary); font-size: 10px; font-weight: 800;
  cursor: pointer; font-family: inherit; text-align: center; transition: all .2s;
  white-space: nowrap;
}
.period-btn.active {
  border-color: var(--accent); background: var(--accent-light); color: var(--accent);
}
.period-btn2 {
  flex: 1; padding: 9px 6px; border-radius: 10px; border: 1.5px solid var(--border);
  background: var(--card-bg); color: var(--text-secondary); font-size: 10px; font-weight: 800;
  cursor: pointer; font-family: inherit; text-align: center; transition: all .2s;
}
.period-btn2.active {
  border-color: var(--accent); background: var(--accent-light); color: var(--accent);
}

/* TOP 3 PODIUM */
.top3-section {
  display: grid; grid-template-columns: 1fr 1fr 1fr;
  gap: 6px; margin-bottom: 8px;
}
.top3-card {
  padding: 10px 6px; border-radius: 12px;
  border: 1.5px solid var(--border); background: var(--card-bg);
  text-align: center; position: relative; overflow: hidden;
}
.top3-card.rank1 {
  border-color: rgba(245,158,11,.5);
  background: linear-gradient(135deg, rgba(245,158,11,.08), var(--card-bg));
}
.top3-card.rank2 {
  border-color: rgba(156,163,175,.4);
  background: linear-gradient(135deg, rgba(156,163,175,.06), var(--card-bg));
}
.top3-card.rank3 {
  border-color: rgba(180,83,9,.4);
  background: linear-gradient(135deg, rgba(180,83,9,.06), var(--card-bg));
}
.top3-crown { font-size: 20px; margin-bottom: 3px; }
.top3-avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--accent-light); margin: 0 auto 4px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; border: 2px solid var(--border); overflow: hidden;
}
.top3-avatar img { width: 100%; height: 100%; object-fit: cover; }
.top3-name { font-size: 10px; font-weight: 900; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.top3-batch { font-size: 9px; color: var(--text-secondary); }
.top3-college { font-size: 8px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.top3-time { font-size: 12px; font-weight: 900; color: var(--accent); margin-top: 2px; }
.top3-breaks { font-size: 8px; color: var(--text-secondary); }
.rank1-badge {
  position: absolute; top: 4px; right: 4px;
  font-size: 8px; font-weight: 900; padding: 1px 5px; border-radius: 6px;
  background: linear-gradient(90deg, #F59E0B, #FBBF24); color: #000;
}

/* ═══ RANK LIST ═══ */
.rank-list { display: flex; flex-direction: column; gap: 4px; }

/* Full-width student card */
.r-card {
  display: flex; align-items: center; gap: 8px;
  background: var(--card-bg); border: 1px solid var(--border);
  border-radius: 12px; padding: 8px 10px; width: 100%;
  position: relative;
}
.r-card.is-live { border-color: rgba(16,185,129,.3); }
.r-card.rank1-card { border-color: rgba(245,158,11,.4); background: rgba(245,158,11,.04); }
.rank1-card::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg, #F59E0B, #FBBF24);
  border-radius: 3px 0 0 3px;
}
.r-rank { font-size: 13px; flex-shrink: 0; width: 22px; text-align: center; }
.r-photo {
  width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
  background: var(--accent-light); display: flex; align-items: center;
  justify-content: center; font-size: 16px; overflow: hidden;
  border: 1.5px solid var(--border);
}
.r-photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.r-info { flex: 1; min-width: 0; }
.r-name { font-size: 12px; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.r-meta { font-size: 9px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.r-right { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; flex-shrink: 0; }
.r-time { font-size: 13px; font-weight: 900; color: #10B981; }
.r-breaks { font-size: 9px; color: var(--text-secondary); }
.r-status {
  display: inline-flex; align-items: center; gap: 3px;
  font-size: 8px; font-weight: 800; padding: 2px 6px; border-radius: 8px;
}
.r-status-study { background: rgba(16,185,129,.12); color: #10B981; }
.r-status-break { background: rgba(245,158,11,.12); color: #F59E0B; }
.r-status-sleep { background: rgba(99,102,241,.12); color: #818CF8; }
.r-status-dot { width: 4px; height: 4px; border-radius: 50%; animation: focusBlink 1.2s ease-in-out infinite; }
.r-status-study .r-status-dot { background: #10B981; }
.r-status-break .r-status-dot { background: #F59E0B; }
.r-status-sleep .r-status-dot { background: #818CF8; }

/* Compare button */
.compare-btn {
  display: flex; align-items: center; gap: 3px;
  padding: 4px 8px; border-radius: 8px;
  border: 1px solid var(--border); background: var(--card-bg);
  color: var(--text-secondary); font-size: 9px; font-weight: 800;
  cursor: pointer; font-family: inherit; white-space: nowrap;
  margin-top: 2px;
}
.compare-btn:hover { border-color: var(--accent); color: var(--accent); }

/* 1st place special vibe */
.rank1-glow {
  position: absolute; top: 0; right: 0; bottom: 0;
  width: 60px; border-radius: 0 12px 12px 0;
  background: linear-gradient(90deg, transparent, rgba(245,158,11,.06));
  pointer-events: none;
}

/* Today's LIVE section */
.live-today-section { padding: 0 14px 6px; }
.live-today-title {
  font-size: 11px; font-weight: 800; color: #10B981;
  display: flex; align-items: center; gap: 5px; margin-bottom: 6px;
}
.live-dot { width: 7px; height: 7px; border-radius: 50%; background: #10B981; animation: livePulse 1.5s ease-in-out infinite; }
@keyframes livePulse {
  0%,100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: .6; }
}

/* All Students Grid */
.all-students-section { padding: 0 14px 6px; }
.as-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.as-title { font-size: 11px; font-weight: 800; color: var(--text); }
.as-count { font-size: 10px; color: var(--text-secondary); }

/* Batch filter */
.batch-filter { display: flex; gap: 6px; padding: 6px 14px; overflow-x: auto; }
.bf-chip { padding: 4px 10px; border-radius: 14px; font-size: 10px; font-weight: 700; white-space: nowrap; cursor: pointer; border: 1px solid var(--border); background: var(--card-bg); color: var(--text-secondary); flex-shrink: 0; }
.bf-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); }

@keyframes focusBlink { 0%,100%{opacity:1} 50%{opacity:.3} }

/* ═══ MOOD POPUP ═══ */
.mood-popup-bg {
  position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 600;
  display: none; align-items: center; justify-content: center; padding: 20px;
}
.mood-popup-bg.show { display: flex; }
.mood-popup {
  background: var(--card-bg); border: 1px solid var(--border);
  border-radius: 16px; padding: 20px; width: 100%; max-width: 300px;
}
.mood-popup h3 { font-size: 16px; font-weight: 900; margin-bottom: 6px; }
.mood-popup p { font-size: 12px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px; }
.mood-popup-toggle {
  width: 100%; padding: 12px; border-radius: 10px; border: none;
  font-size: 13px; font-weight: 800; cursor: pointer; font-family: inherit;
  margin-bottom: 8px;
}
.popup-toggle-off { background: rgba(239,68,68,.15); color: #EF4444; border: 1.5px solid rgba(239,68,68,.3); }
.popup-toggle-off:hover { background: rgba(239,68,68,.25); }
.popup-cancel { background: var(--card-bg); color: var(--text-secondary); border: 1.5px solid var(--border); }

/* ═══ COMPARE MODAL ═══ */
.compare-modal-bg {
  position: fixed; inset: 0; background: rgba(0,0,0,.75); z-index: 600;
  display: none; align-items: flex-start; justify-content: center; padding: 20px;
  overflow-y: auto;
}
.compare-modal-bg.show { display: flex; }
.compare-modal {
  background: var(--card-bg); border: 1px solid var(--border);
  border-radius: 16px; padding: 16px; width: 100%; max-width: 340px; margin: auto;
}
.cm-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.cm-title { font-size: 14px; font-weight: 900; }
.cm-close { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border); background: none; color: var(--text-secondary); cursor: pointer; font-size: 14px; }
.cm-vs-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: center; margin-bottom: 14px; }
.cm-person { text-align: center; }
.cm-avatar {
  width: 48px; height: 48px; border-radius: 50%; margin: 0 auto 4px;
  background: var(--accent-light); display: flex; align-items: center;
  justify-content: center; font-size: 22px; border: 2px solid var(--border);
}
.cm-pname { font-size: 12px; font-weight: 900; }
.cm-pmeta { font-size: 9px; color: var(--text-secondary); }
.cm-vs { font-size: 14px; font-weight: 900; color: var(--text-secondary); text-align: center; }
.cm-period-row { display: flex; gap: 4px; margin-bottom: 10px; overflow-x: auto; }
.cm-period-btn {
  padding: 4px 10px; border-radius: 10px; border: 1px solid var(--border);
  background: var(--card-bg); color: var(--text-secondary); font-size: 9px; font-weight: 800;
  cursor: pointer; font-family: inherit; white-space: nowrap; flex-shrink: 0;
}
.cm-period-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.cm-stats { background: var(--bg); border-radius: 10px; padding: 10px; margin-bottom: 10px; }
.cm-stat-row { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
.cm-stat-label { font-size: 9px; color: var(--text-secondary); width: 55px; flex-shrink: 0; text-align: right; }
.cm-bar-wrap { flex: 1; display: flex; align-items: center; gap: 4px; }
.cm-bar { height: 8px; border-radius: 6px; min-width: 4px; transition: width .5s; }
.cm-bar-me { background: var(--accent); }
.cm-bar-them { background: #818CF8; }
.cm-bar-val { font-size: 9px; font-weight: 800; flex-shrink: 0; }
.cm-verdict {
  padding: 10px 12px; border-radius: 10px;
  background: rgba(16,185,129,.08); border: 1px solid rgba(16,185,129,.2);
  font-size: 11px; line-height: 1.6; color: var(--text);
}
.cm-verdict.behind { background: rgba(239,68,68,.08); border-color: rgba(239,68,68,.2); }

/* ═══ END MODAL ═══ */
.focus-modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,.75); z-index: 500; display: none; align-items: center; justify-content: center; padding: 20px; }
.focus-modal-bg.show { display: flex; }
.focus-modal { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; width: 100%; max-width: 300px; text-align: center; }
.focus-modal h3 { font-size: 16px; font-weight: 900; margin-bottom: 6px; }
.focus-modal p { font-size: 11px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 14px; }
.focus-modal-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 14px; background: var(--bg); border-radius: 8px; padding: 10px; }
.fms-val { font-size: 20px; font-weight: 900; color: var(--accent); }
.fms-lbl { font-size: 9px; color: var(--text-secondary); margin-top: 1px; }
.focus-modal-row { display: flex; gap: 8px; }
.focus-modal-row button { flex: 1; }

/* ── Icon tiles (shared with home page) ── */
.si-tile{width:28px;height:28px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 2px 6px rgba(0,0,0,.25)}
.si-tile svg{width:16px;height:16px}
.tile-indigo{background:linear-gradient(150deg,#7B7FFF 0%,#5A5FE0 45%,#322B96 100%)}
.tile-amber{background:linear-gradient(150deg,#FFD166 0%,#F5A524 45%,#A8650A 100%)}
.tile-violet{background:linear-gradient(150deg,#A78BFA 0%,#8B5CF6 45%,#4C1D95 100%)}
.tile-rose{background:linear-gradient(150deg,#FB7AAE 0%,#F43F8E 45%,#9D174D 100%)}
.tile-emerald{background:linear-gradient(150deg,#34D9A0 0%,#10B981 45%,#065F46 100%)}
.tile-sky{background:linear-gradient(150deg,#7DD3FC 0%,#38BDF8 45%,#075985 100%)}
.tile-orange{background:linear-gradient(150deg,#FDBA74 0%,#FB923C 45%,#9A3412 100%)}
.tile-teal{background:linear-gradient(150deg,#5EEAD4 0%,#14B8A6 45%,#115E59 100%)}
.tile-red{background:linear-gradient(150deg,#FCA5A5 0%,#F87171 45%,#991B1B 100%)}
.tile-gold{background:linear-gradient(150deg,#FDE68A 0%,#FBBF24 45%,#92400E 100%)}
.tile-plum{background:linear-gradient(150deg,#D8B4FE 0%,#A855F7 45%,#581C87 100%)}
.ni-tile{width:26px;height:26px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:2px;box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 2px 5px rgba(0,0,0,.2)}
.ni-tile svg{width:14px;height:14px}

/* Warn bar */
.break-warn-bar { margin: 0 14px 6px; padding: 6px 12px; background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.35); border-radius: 8px; font-size: 11px; color: #F59E0B; text-align: center; font-weight: 600; display: none; }
.break-warn-bar.show { display: block; }

/* Section divider */
.sec-divider { height: 1px; background: var(--border); margin: 8px 14px; opacity: .5; }

</style>
</head>

<body class="dark-mode">
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header"><div class="sidebar-logo">ATLAS APP</div></div>
  <div class="sidebar-menu">
    <button class="sidebar-item" onclick="navigateTo('profile');closeSidebar();"><span class="si-tile tile-sky"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="#fff" stroke-width="1.8"/><path d="M4.5 20c0-3.6 3.4-6.5 7.5-6.5s7.5 2.9 7.5 6.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg></span> প্রোফাইল</button>
    <button class="sidebar-item" onclick="goTo('index.html');closeSidebar();"><span class="si-tile tile-indigo"><svg viewBox="0 0 24 24" fill="none"><path d="M3 10L12 3l9 7v9a1 1 0 01-1 1H4a1 1 0 01-1-1v-9z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" fill="rgba(255,255,255,0.15)"/><path d="M9 21V12h6v9" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/></svg></span> হোম</button>
    <button class="sidebar-item" onclick="goTo('study-aid.html');closeSidebar();"><span class="si-tile tile-teal"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3h5a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2h-3a2 2 0 01-4 0H7a2 2 0 01-2-2v-3a2 2 0 000-4V5a2 2 0 012-2h5z" stroke="#fff" stroke-width="1.7" fill="rgba(255,255,255,0.08)"/></svg></span> Study Aid</button>
    <button class="sidebar-item" onclick="goTo('study.html');closeSidebar();"><span class="si-tile tile-violet"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5.5C10.3 4.4 7.7 4 5.5 4.3v13.4c2.2-.3 4.8.1 6.5 1.2 1.7-1.1 4.3-1.5 6.5-1.2V4.3C16.3 4 13.7 4.4 12 5.5z" stroke="#fff" stroke-width="1.8"/><path d="M12 5.5v13.4" stroke="#fff" stroke-width="1.8"/></svg></span> মূলবই</button>
    <div class="sidebar-divider"></div>
    <button class="sidebar-item" onclick="toggleTheme()"><span class="si-tile tile-indigo"><svg viewBox="0 0 24 24" fill="none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="#fff" stroke-width="1.8" fill="rgba(255,255,255,0.12)"/></svg></span> ডার্ক মোড</button>
  </div>
  <div class="sidebar-footer">
    <button class="sidebar-item logout-btn" onclick="logout()"><span class="si-tile tile-red"><svg viewBox="0 0 24 24" fill="none"><path d="M14 3H6a1 1 0 00-1 1v16a1 1 0 001 1h8" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/><path d="M18 7l4 5-4 5M22 12H10" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span> লগআউট</button>
  </div>
</aside>

<header class="header">
  <div class="header-left">
    <button class="hamburger" onclick="toggleSidebar()">☰</button>
    <div class="atlas-brand-box" onclick="goTo('index.html')">
      <img src="https://cdn.phototourl.com/free/2026-05-15-b45df560-6dc8-4cb7-9040-238612c8a161.png" class="atlas-logo-img" alt="ATLAS">
      <span class="atlas-brand-text">ATLAS APP</span>
    </div>
  </div>
  <div class="header-right">
    <button class="header-icon" onclick="toggleTheme()" id="themeToggle"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.8" fill="rgba(255,255,255,0.1)"/></svg></button>
    <button class="header-icon" onclick="navigateTo('profile')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M4.5 20c0-3.6 3.4-6.5 7.5-6.5s7.5 2.9 7.5 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
  </div>
</header>

<!-- ═══════════ END CONFIRM MODAL ═══════════ -->
<div class="focus-modal-bg" id="endModal">
  <div class="focus-modal">
    <h3>⏹ Session শেষ করবে?</h3>
    <p>Timer বন্ধ হবে এবং পড়াশোনার সময় সেভ হবে।</p>
    <div class="focus-modal-stats">
      <div><div class="fms-val" id="ms-time">0:00</div><div class="fms-lbl">পড়ার সময়</div></div>
      <div><div class="fms-val" id="ms-breaks">0</div><div class="fms-lbl">বিরতি নেওয়া</div></div>
    </div>
    <div class="focus-modal-row">
      <button class="btn btn-outline" onclick="closeModal()" style="flex:1">← ফিরে যাও</button>
      <button class="btn btn-primary" onclick="confirmEnd()" style="flex:1;background:var(--error)">শেষ করো</button>
    </div>
  </div>
</div>

<!-- ═══════════ MOOD SWITCH POPUP ═══════════ -->
<div class="mood-popup-bg" id="moodPopup">
  <div class="mood-popup">
    <h3 id="moodPopupTitle">⚠️ মোড পরিবর্তন</h3>
    <p id="moodPopupMsg">Study Timer চলছে। Break / Sleep Mode on করতে হলে আগে বন্ধ করো। এই সময়গুলো Top Focused rank এ count হয়।</p>
    <button class="mood-popup-toggle popup-toggle-off" id="moodPopupConfirm" onclick="confirmMoodSwitch()">এই Mood বন্ধ করো</button>
    <button class="mood-popup-toggle popup-cancel" onclick="closeMoodPopup()">বাতিল</button>
  </div>
</div>

<!-- ═══════════ COMPARE MODAL ═══════════ -->
<div class="compare-modal-bg" id="compareModal">
  <div class="compare-modal">
    <div class="cm-header">
      <div class="cm-title">⚡ তুলনা</div>
      <button class="cm-close" onclick="closeCompare()">✕</button>
    </div>
    <div class="cm-vs-row">
      <div class="cm-person">
        <div class="cm-avatar" id="cmMeAvatar">😊</div>
        <div class="cm-pname" id="cmMeName">তুমি</div>
        <div class="cm-pmeta" id="cmMeMeta"></div>
      </div>
      <div class="cm-vs">VS</div>
      <div class="cm-person">
        <div class="cm-avatar" id="cmThemAvatar">👤</div>
        <div class="cm-pname" id="cmThemName">—</div>
        <div class="cm-pmeta" id="cmThemMeta"></div>
      </div>
    </div>
    <div class="cm-period-row">
      <button class="cm-period-btn active" onclick="setCmpPeriod(1,this)">আজকে</button>
      <button class="cm-period-btn" onclick="setCmpPeriod(3,this)">৩ দিন</button>
      <button class="cm-period-btn" onclick="setCmpPeriod(7,this)">৭ দিন</button>
      <button class="cm-period-btn" onclick="setCmpPeriod(15,this)">১৫ দিন</button>
      <button class="cm-period-btn" onclick="setCmpPeriod(30,this)">৩০ দিন</button>
    </div>
    <div class="cm-stats" id="cmStats">
      <div style="text-align:center;padding:16px;color:var(--text-secondary);font-size:11px">তুলনা লোড হচ্ছে...</div>
    </div>
    <div class="cm-verdict" id="cmVerdict"></div>
  </div>
</div>

<!-- ═══════════ MAIN ═══════════ -->
<main class="focus-container">

  <!-- ═══ INTRO SCREEN ═══ -->
  <div id="introScreen">
    <div class="intro-wrap">
      <div class="intro-hero">
        <div class="intro-icon">⏱️</div>
        <div class="intro-title">ATLAS Focus Timer</div>
        <div class="intro-sub">মনোযোগী পড়াশোনার জন্য বাংলাদেশের সেরা টাইমার</div>
      </div>
      <div class="premium-box">
        <div class="premium-box-title">✨ কেন ব্যবহার করবে?</div>
        <ul class="feature-list">
          <li>পড়াশোনার সময় track করো এবং নিজেকে motivate রাখো</li>
          <li>Live দেখো কতজন student এই মুহূর্তে পড়ছে</li>
          <li>Top Focused Student হওয়ার সুযোগ পাও</li>
          <li>Study, Break ও Sleep Mood আলাদাভাবে track হবে</li>
        </ul>
      </div>
      <div class="how-box">
        <div class="how-title">📋 কীভাবে ব্যবহার করবে?</div>
        <div class="how-step"><div class="how-step-num">১</div><span>"পড়াশোনা শুরু করো" বাটনে চাপো — Study Mood timer শুরু হবে</span></div>
        <div class="how-step"><div class="how-step-num">২</div><span>ক্লান্ত হলে Break Mood চাপো — Study pause হয়ে Break timer শুরু হবে</span></div>
        <div class="how-step"><div class="how-step-num">৩</div><span>Sleep Mood on থাকলে phone off করলেও timer চলতে থাকবে</span></div>
        <div class="how-step"><div class="how-step-num">৪</div><span>পড়া শেষে Stop — সময় সেভ হবে এবং rank update হবে</span></div>
      </div>
      <button class="intro-start-btn" onclick="startSession()">▶ পড়াশোনা শুরু করো</button>
    </div>
  </div>

  <!-- ═══ TIMER SCREEN ═══ -->
  <div class="timer-screen" id="timerScreen">

    <!-- User Header -->
    <div class="user-header-box">
      <div class="uhb-left">
        <div class="uhb-avatar" id="uhbAvatar">
          <div class="uhb-avatar-glow"></div>
          <span id="uhbInitial">?</span>
        </div>
        <div>
          <div class="uhb-name" id="uhbName">লোড হচ্ছে...</div>
          <div class="uhb-batch-pill" id="uhbBatch">HSC ২৬</div>
        </div>
      </div>
      <div class="uhb-right">
        <button class="history-btn" onclick="goTo('study-history.html')">
          📊 Study Time History
        </button>
      </div>
    </div>

    <!-- Ticker (live scrolling names) -->
    <div class="header-ticker">
      <div class="ticker-label">🟢 LIVE</div>
      <div class="ticker-track">
        <div class="ticker-inner" id="tickerInner">
          <span style="font-size:10px;color:var(--text-secondary)">লোড হচ্ছে...</span>
        </div>
      </div>
    </div>

    <!-- ═══ MOOD BUTTONS (Right-to-left: Study, Break, Sleep) ═══ -->
    <div class="mood-row">
      <button class="mood-btn mood-study active" id="btnStudy" onclick="switchMood('study')">
        <span class="mood-icon">📚</span>
        <span class="mood-label">Study</span>
        <span class="mood-dot"></span>
      </button>
      <button class="mood-btn mood-break" id="btnBreak" onclick="switchMood('break')">
        <span class="mood-icon">☕</span>
        <span class="mood-label">Break</span>
        <span class="mood-dot"></span>
      </button>
      <button class="mood-btn mood-sleep" id="btnSleep" onclick="switchMood('sleep')">
        <span class="mood-icon">😴</span>
        <span class="mood-label">Sleep</span>
        <span class="mood-dot"></span>
      </button>
    </div>

    <!-- ═══ TIMER RING ═══ -->
    <div class="timer-main">
      <div class="timer-ring-wrap">
        <svg class="timer-svg" width="180" height="180" viewBox="0 0 180 180">
          <circle class="t-track" cx="90" cy="90" r="85"/>
          <circle class="t-ring" cx="90" cy="90" r="85" id="tRing"/>
        </svg>
        <div class="timer-center">
          <div class="t-time-row">
            <span class="t-hours" id="tHours">00</span>
            <span class="t-colon">:</span>
            <span class="t-mins" id="tMins">00</span>
            <span class="t-colon2">:</span>
            <span class="t-secs" id="tSecs">00</span>
          </div>
          <div class="t-label" id="tLabel">পড়াশোনা</div>
          <div class="t-mood-badge badge-study" id="tMoodBadge">📚 Study Mood</div>
        </div>
      </div>
    </div>

    <!-- Pause / Resume / Stop controls -->
    <div class="timer-controls">
      <button class="ctrl-btn ctrl-pause" id="ctrlPause" onclick="pauseTimer()">⏸ Pause</button>
      <button class="ctrl-btn ctrl-resume" id="ctrlResume" onclick="resumeTimer()" style="display:none">▶ Resume</button>
      <button class="ctrl-btn ctrl-stop" onclick="showModal()">⏹ Stop</button>
    </div>

    <!-- Warn bar -->
    <div class="break-warn-bar" id="breakWarn"></div>

    <!-- ═══ TOP FOCUSED ═══ -->
    <div class="top-focused-box" id="topFocusedBox">
      <div class="tf-trophy">🏆</div>
      <div class="tf-info">
        <div class="tf-label">TOP FOCUSED TODAY</div>
        <div class="tf-name" id="tfName">—</div>
        <div class="tf-meta" id="tfMeta"></div>
      </div>
      <div class="tf-stats">
        <div class="tf-time" id="tfTime">—</div>
        <div class="tf-premium">PREMIUM</div>
      </div>
    </div>

    <!-- ═══ LIVE STATS ═══ -->
    <div class="live-stats-row">
      <div class="lsr-card">
        <div class="lsr-val green" id="lsrStudy">0</div>
        <div class="lsr-lbl">📚 পড়ছে</div>
      </div>
      <div class="lsr-card">
        <div class="lsr-val amber" id="lsrBreak">0</div>
        <div class="lsr-lbl">☕ বিরতিতে</div>
      </div>
      <div class="lsr-card">
        <div class="lsr-val purple" id="lsrSleep">0</div>
        <div class="lsr-lbl">😴 ঘুমাচ্ছে</div>
      </div>
    </div>

    <!-- Break People -->
    <div class="break-people-box" id="breakPeopleBox">
      <div class="bpb-title">☕ এখন বিরতিতে আছে</div>
      <div class="bpb-list" id="breakPeopleList"></div>
    </div>

    <!-- Sleep People -->
    <div class="sleep-people-box" id="sleepPeopleBox">
      <div class="spb-title">😴 এখন ঘুমাচ্ছে</div>
      <div class="spb-list" id="sleepPeopleList"></div>
    </div>

    <div class="sec-divider"></div>

    <!-- ═══ LEADERBOARD ═══ -->
    <div class="leaderboard-section">
      <div class="lb-title">🏅 Leaderboard</div>

      <!-- Period row 1: আজকে, ৩, ৭ -->
      <div class="lb-period-row">
        <button class="period-btn active" onclick="setPeriod(1,this)">আজকে</button>
        <button class="period-btn" onclick="setPeriod(3,this)">বিগত ৩ দিন</button>
        <button class="period-btn" onclick="setPeriod(7,this)">বিগত ৭ দিন</button>
      </div>
      <!-- Period row 2: ১৫, ৩০ -->
      <div class="lb-period-row2">
        <button class="period-btn2" onclick="setPeriod(15,this)">বিগত ১৫ দিন</button>
        <button class="period-btn2" onclick="setPeriod(30,this)">বিগত ৩০ দিন</button>
      </div>

      <!-- Top 3 Podium -->
      <div class="top3-section" id="top3Section"></div>

      <!-- Rank List (4th onwards) -->
      <div class="rank-list" id="rankList"></div>
    </div>

    <div class="sec-divider"></div>

    <!-- ═══ TODAY LIVE ═══ -->
    <div class="live-today-section">
      <div class="live-today-title">
        <div class="live-dot"></div>
        এখন Live পড়ছে
      </div>
      <div class="batch-filter" id="batchFilter"></div>
      <div class="rank-list" id="liveStudentsList"></div>
    </div>

  </div><!-- end timer-screen -->
</main>

