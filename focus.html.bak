  <button class="nav-item" onclick="goTo('index.html')"><span class="nav-icon"><span class="ni-tile tile-indigo"><svg viewBox="0 0 24 24" fill="none"><path d="M3 10L12 3l9 7v9a1 1 0 01-1 1H4a1 1 0 01-1-1v-9z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" fill="rgba(255,255,255,0.15)"/><path d="M9 21V12h6v9" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/></svg></span></span>হোম</button>
  <button class="nav-item" onclick="goTo('class.html')"><span class="nav-icon"><span class="ni-tile tile-violet"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5.5C10.3 4.4 7.7 4 5.5 4.3v13.4c2.2-.3 4.8.1 6.5 1.2 1.7-1.1 4.3-1.5 6.5-1.2V4.3C16.3 4 13.7 4.4 12 5.5z" stroke="#fff" stroke-width="1.8"/><path d="M12 5.5v13.4" stroke="#fff" stroke-width="1.8"/></svg></span></span>ক্লাস</button>
  <button class="nav-item" onclick="goTo('exam.html')"><span class="nav-icon"><span class="ni-tile tile-orange"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="2" stroke="#fff" stroke-width="1.8" fill="rgba(255,255,255,0.12)"/><path d="M8 8h8M8 12h8M8 16h5" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg></span></span>এক্সাম</button>
  <button class="nav-item" onclick="goTo('mock-test.html')"><span class="nav-icon"><span class="ni-tile tile-rose"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="#fff" stroke-width="1.8"/><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.6"/><circle cx="12" cy="12" r="1.5" fill="#fff"/></svg></span></span>মক</button>
  <button class="nav-item active" onclick="goTo('study-aid.html')"><span class="nav-icon"><span class="ni-tile tile-teal"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3h5a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2h-3a2 2 0 01-4 0H7a2 2 0 01-2-2v-3a2 2 0 000-4V5a2 2 0 012-2h5z" stroke="#fff" stroke-width="1.7" fill="rgba(255,255,255,0.08)"/></svg></span></span>Study Aid</button>
  <button class="nav-item" onclick="navigateTo('profile')"><span class="nav-icon"><span class="ni-tile tile-sky"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="#fff" stroke-width="1.8"/><path d="M4.5 20c0-3.6 3.4-6.5 7.5-6.5s7.5 2.9 7.5 6.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg></span></span>প্রোফাইল</button>
</nav>

<div class="toast" id="toast"></div>

<script>
/* ═══════════════════════════════════════
   ATLAS FOCUS TIMER — FULL JS
═══════════════════════════════════════ */
const SUPABASE_URL = 'https://btezborkuiqfogykrjrn.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ0ZXpib3JrdWlxZm9neWtyanJuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg2NTIyNzUsImV4cCI6MjA5NDIyODI3NX0.G4C7YTmk-AEvhWXnx-phMjTh9pxbdhCiapYVDpSVsEw';

/* ── Helpers ── */
let isDarkMode = true, isSidebarOpen = false, currentUser = null;

function showToast(m,d=2500){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),d);}
function toggleTheme(){isDarkMode=!isDarkMode;document.body.classList.toggle('dark-mode',isDarkMode);document.body.classList.toggle('light-mode',!isDarkMode);document.getElementById('themeToggle').innerHTML=isDarkMode?'<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.8"/></svg>':'☀️';localStorage.setItem('atlas-theme',isDarkMode?'dark':'light');}
function toggleSidebar(){isSidebarOpen=!isSidebarOpen;document.getElementById('sidebarOverlay').classList.toggle('active',isSidebarOpen);document.getElementById('sidebar').classList.toggle('active',isSidebarOpen);}
function closeSidebar(){isSidebarOpen=false;document.getElementById('sidebarOverlay').classList.remove('active');document.getElementById('sidebar').classList.remove('active');}
function goTo(u){location.href=u;}
function navigateTo(p){const r={home:'index.html',profile:'profile.html',class:'class.html',exam:'exam.html'};goTo(r[p]||'index.html');}
function logout(){localStorage.removeItem('atlas-session');goTo('index.html');}
function escHtml(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

async function safeFetch(url, opts={}) {
  opts.headers = Object.assign({ apikey: SUPABASE_KEY, Authorization: 'Bearer '+SUPABASE_KEY }, opts.headers||{});
  if(!opts.headers['Content-Type'] && opts.method!=='DELETE') opts.headers['Content-Type']='application/json';
  if(opts.method==='POST'||opts.method==='PATCH') opts.headers['Prefer']='return=representation';
  try {
    const res = await fetch(url, opts);
    const text = await res.text();
    if(!text?.trim()) return [];
    const data = JSON.parse(text);
    if(!res.ok) throw new Error(data.message||'API Error');
    return data;
  } catch(e){ console.error('❌', e.message); return []; }
}

/* ═══ CONSTANTS ═══ */
const MAX_BREAK_SEC = 3600;
const CIRC = 2 * Math.PI * 85; // r=85

/* ═══ STATE ═══ */
let mood = 'study';          // 'study' | 'break' | 'sleep'
let timerRunning = false;
let paused = false;
let sessionId = null;
let studySecs = 0, breakSecs = 0, sleepSecs = 0, breaksUsed = 0;
let ticker = null, pollInterval = null;
let allStudents = [], selectedBatch = 'all';
let currentPeriod = 1;       // leaderboard days
let pendingMood = null;       // mood awaiting popup confirm

/* ═══ FORMAT ═══ */
function fmtHMS(s) {
  const h = Math.floor(s/3600), m = Math.floor((s%3600)/60), sec = s%60;
  return { h: String(h).padStart(2,'0'), m: String(m).padStart(2,'0'), s: String(sec).padStart(2,'0') };
}
function fmtCompact(s) {
  const h=Math.floor(s/3600),m=Math.floor((s%3600)/60);
  if(h>0) return `${h}ঘ ${m}মি`;
  return `${m}মি ${s%60}সে`;
}
function fmtDisplay(s){
  const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;
  if(h>0) return `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
  return `0:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
}

/* ═══ PERSISTENCE ═══ */
const STATE_KEY = 'focus_state_v2';
function saveState(){
  localStorage.setItem(STATE_KEY, JSON.stringify({mood,paused,sessionId,studySecs,breakSecs,sleepSecs,breaksUsed,savedAt:Date.now()}));
}
function loadState(){try{return JSON.parse(localStorage.getItem(STATE_KEY));}catch(_){return null;}}
function clearState(){localStorage.removeItem(STATE_KEY);}

/* ═══ SESSION START ═══ */
async function startSession(){
  if(!currentUser){ showToast('⚠️ লগইন করো'); goTo('auth.html'); return; }
  mood='study'; timerRunning=true; paused=false;
  studySecs=0; breakSecs=0; sleepSecs=0; breaksUsed=0;
  const rows = await safeFetch(`${SUPABASE_URL}/rest/v1/focus_sessions`,{
    method:'POST',
    body:JSON.stringify({user_phone:currentUser.phone, status:'study'})
  });
  sessionId = rows?.[0]?.id || null;
  showTimerScreen();
  renderTimer();
  saveState();
  ticker = setInterval(tick, 1000);
  renderLive();
  startPolling();
}

function showTimerScreen(){
  document.getElementById('introScreen').style.display='none';
  document.getElementById('timerScreen').classList.add('show');
  renderUserHeader();
}

/* ═══ TICK ═══ */
function tick(){
  if(paused) return;
  if(mood==='study') studySecs++;
  else if(mood==='break'){ breakSecs++; if(breakSecs>=MAX_BREAK_SEC){ autoEndBreak(); return; } }
  else if(mood==='sleep') sleepSecs++;
  renderTimer();
  if((studySecs+breakSecs+sleepSecs)%20===0){ saveState(); syncSession(); }
}

function autoEndBreak(){
  showToast('⏰ বিরতির সময় শেষ — Study Mood এ ফিরে এলে');
  mood='study'; breakSecs=0; breaksUsed++;
  renderTimer(); updateMoodButtons(); saveState(); syncSession();
}

async function syncSession(){
  if(!sessionId) return;
  await safeFetch(`${SUPABASE_URL}/rest/v1/focus_sessions?id=eq.${sessionId}`,{
    method:'PATCH',
    body:JSON.stringify({status:mood,study_seconds:studySecs,break_seconds:breakSecs,sleep_seconds:sleepSecs,breaks_used:breaksUsed,updated_at:new Date().toISOString()})
  });
}

/* ═══ RENDER TIMER ═══ */
function renderTimer(){
  let displaySecs, ringColor, badgeClass, labelText, badgeText;
  if(mood==='study'){
    displaySecs=studySecs; ringColor='var(--accent)';
    badgeClass='badge-study'; labelText='পড়াশোনা'; badgeText='📚 Study Mood';
  } else if(mood==='break'){
    displaySecs=breakSecs; ringColor='#F59E0B';
    badgeClass='badge-break'; labelText='বিরতি'; badgeText='☕ Break Mood';
    // warn
    const remain=MAX_BREAK_SEC-breakSecs;
    const wb=document.getElementById('breakWarn');
    if(remain<=300){ wb.textContent=`⚠️ বিরতি শেষ হতে ${fmtDisplay(remain)} বাকি`; wb.classList.add('show'); }
    else wb.classList.remove('show');
  } else {
    displaySecs=sleepSecs; ringColor='#6366F1';
    badgeClass='badge-sleep'; labelText='ঘুমাচ্ছি'; badgeText='😴 Sleep Mood';
    document.getElementById('breakWarn').classList.remove('show');
  }
  if(mood!=='break') document.getElementById('breakWarn').classList.remove('show');

  const f=fmtHMS(displaySecs);
  document.getElementById('tHours').textContent=f.h;
  document.getElementById('tMins').textContent=f.m;
  document.getElementById('tSecs').textContent=f.s;
  document.getElementById('tLabel').textContent=labelText;

  const badge=document.getElementById('tMoodBadge');
  badge.className='t-mood-badge '+badgeClass;
  badge.textContent=badgeText;

  const ring=document.getElementById('tRing');
  const progress=(displaySecs%1800)/1800; // cycles every 30 min
  ring.style.strokeDashoffset=CIRC*(1-progress);
  ring.style.stroke=ringColor;
}

/* ═══ MOOD SWITCH ═══ */
function switchMood(newMood){
  if(!timerRunning){ showToast('⚠️ আগে পড়াশোনা শুরু করো'); return; }
  if(newMood===mood) return; // already active

  // If switching TO study while break/sleep active → show popup
  if(newMood==='study' && (mood==='break'||mood==='sleep')){
    pendingMood=newMood;
    const currentName=mood==='break'?'Break':'Sleep';
    document.getElementById('moodPopupTitle').textContent=`⚠️ ${currentName} Mood চলছে`;
    document.getElementById('moodPopupMsg').textContent=`${currentName} Mood এ থাকা সময় rank calculation এ count হয়। Study Mood এ ফিরতে চাইলে ${currentName} Mood বন্ধ করতে হবে।`;
    document.getElementById('moodPopupConfirm').textContent=`${currentName} Mood বন্ধ করে Study শুরু করো`;
    document.getElementById('moodPopup').classList.add('show');
    return;
  }

  // If switching TO break/sleep while study active → show popup
  if((newMood==='break'||newMood==='sleep') && mood==='study'){
    pendingMood=newMood;
    const newName=newMood==='break'?'Break':'Sleep';
    document.getElementById('moodPopupTitle').textContent=`⚠️ Study Mood চলছে`;
    document.getElementById('moodPopupMsg').textContent=`Study Mood pause হবে এবং ${newName} Mood শুরু হবে। Break ও Sleep সময় rank এ count হয় — তাই সঠিকভাবে ব্যবহার করো।`; 
    document.getElementById('moodPopupConfirm').textContent=`Study Pause করে ${newName} শুরু করো`;
    document.getElementById('moodPopup').classList.add('show');
    return;
  }

  // break → sleep or sleep → break direct
  applyMoodSwitch(newMood);
}

function confirmMoodSwitch(){
  closeMoodPopup();
  if(pendingMood) applyMoodSwitch(pendingMood);
  pendingMood=null;
}

function applyMoodSwitch(newMood){
  if(newMood==='break') breaksUsed++;
  mood=newMood; paused=false;
  if(newMood==='break') breakSecs=0;
  if(newMood==='sleep') sleepSecs=0;
  updateMoodButtons(); renderTimer(); saveState(); syncSession();
  const names={study:'📚 Study Mood',break:'☕ Break Mood',sleep:'😴 Sleep Mood'};
  showToast(`${names[newMood]} শুরু হলো`);
}

function closeMoodPopup(){ document.getElementById('moodPopup').classList.remove('show'); pendingMood=null; }

function updateMoodButtons(){
  document.getElementById('btnStudy').classList.toggle('active',mood==='study');
  document.getElementById('btnBreak').classList.toggle('active',mood==='break');
  document.getElementById('btnSleep').classList.toggle('active',mood==='sleep');
}

/* ═══ PAUSE / RESUME ═══ */
function pauseTimer(){
  paused=true;
  document.getElementById('ctrlPause').style.display='none';
  document.getElementById('ctrlResume').style.display='flex';
  saveState(); syncSession();
  showToast('⏸ Timer pause হলো');
}

function resumeTimer(){
  paused=false;
  document.getElementById('ctrlPause').style.display='flex';
  document.getElementById('ctrlResume').style.display='none';
  saveState(); syncSession();
  showToast('▶ Timer চালু হলো');
}

/* ═══ STOP ═══ */
function showModal(){
  document.getElementById('ms-time').textContent=fmtDisplay(studySecs);
  document.getElementById('ms-breaks').textContent=breaksUsed;
  document.getElementById('endModal').classList.add('show');
}
function closeModal(){ document.getElementById('endModal').classList.remove('show'); }
function confirmEnd(){ closeModal(); doEnd(false); }

async function doEnd(auto){
  clearInterval(ticker); stopPolling(); timerRunning=false;
  if(sessionId){
    await safeFetch(`${SUPABASE_URL}/rest/v1/focus_sessions?id=eq.${sessionId}`,{
      method:'PATCH',
      body:JSON.stringify({status:'ended',study_seconds:studySecs,break_seconds:breakSecs,sleep_seconds:sleepSecs,breaks_used:breaksUsed,ended_at:new Date().toISOString()})
    });
    await upsertDailyTotal(studySecs);
  }
  clearState();
  showToast(auto?'⏹ Auto ended':` ✅ সম্পন্ন! ${fmtDisplay(studySecs)} পড়েছো`,3500);
  setTimeout(()=>goTo('study-aid.html'),1200);
}

async function upsertDailyTotal(addSecs){
  if(!currentUser||!addSecs) return;
  const today=new Date().toISOString().slice(0,10);
  try {
    const ex=await safeFetch(`${SUPABASE_URL}/rest/v1/study_tracker_daily?user_phone=eq.${encodeURIComponent(currentUser.phone)}&study_date=eq.${today}&select=*`);
    if(ex?.length){
      await safeFetch(`${SUPABASE_URL}/rest/v1/study_tracker_daily?id=eq.${ex[0].id}`,{method:'PATCH',body:JSON.stringify({total_seconds:(ex[0].total_seconds||0)+addSecs})});
    } else {
      await safeFetch(`${SUPABASE_URL}/rest/v1/study_tracker_daily`,{method:'POST',body:JSON.stringify({user_phone:currentUser.phone,study_date:today,total_seconds:addSecs})});
    }
  } catch(_){}
}

/* ═══ USER HEADER ═══ */
function renderUserHeader(){
  if(!currentUser) return;
  const name=currentUser.name||'Student';
  const batch=currentUser.batch||'HSC ২৬';
  const initial=name.charAt(0).toUpperCase();
  document.getElementById('uhbInitial').textContent=initial;
  document.getElementById('uhbName').textContent=name;
  document.getElementById('uhbBatch').textContent=`HSC ${batch}`;
}

/* ═══ TICKER ═══ */
function updateTicker(students){
  const el=document.getElementById('tickerInner');
  if(!students.length){ el.innerHTML='<span style="font-size:10px;color:var(--text-secondary)">কেউ পড়ছে না এখন</span>'; return; }
  const chips=students.map(s=>{
    const cls=s.status==='break'?'tc-break':s.status==='sleep'?'tc-sleep':'tc-study';
    const dot=s.status==='break'?'ticker-dot-a':s.status==='sleep'?'ticker-dot-p':'ticker-dot-g';
    const icon=s.status==='break'?'☕':s.status==='sleep'?'😴':'📚';
    return `<span class="ticker-chip ${cls}"><span class="ticker-dot ${dot}"></span>${icon} ${escHtml(s.name)}</span>`;
  }).join('');
  // Duplicate for seamless scroll
  el.innerHTML=chips+chips;
}

/* ═══ LIVE POLLING ═══ */
function startPolling(){ stopPolling(); pollInterval=setInterval(renderLive,10000); }
function stopPolling(){ if(pollInterval){clearInterval(pollInterval);pollInterval=null;} }

const MEDALS=['🥇','🥈','🥉'];

async function renderLive(){
  try {
    const rows=await safeFetch(`${SUPABASE_URL}/rest/v1/focus_sessions?status=in.(study,break,sleep)&select=*,users(name,batch,college,premium)&order=study_seconds.desc&limit=100`);
    const students=(rows||[]).map(r=>({
      name:r.users?.name||'Student',
      batch:r.users?.batch||null,
      college:r.users?.college||null,
      premium:r.users?.premium||false,
      status:r.status||'study',
      study_seconds:r.study_seconds||0,
      break_seconds:r.break_seconds||0,
      sleep_seconds:r.sleep_seconds||0,
      breaks_used:r.breaks_used||0,
      phone:r.user_phone
    }));

    allStudents=students;
    const studying=students.filter(s=>s.status==='study');
    const onBreak=students.filter(s=>s.status==='break');
    const sleeping=students.filter(s=>s.status==='sleep');

    // Stats
    document.getElementById('lsrStudy').textContent=studying.length;
    document.getElementById('lsrBreak').textContent=onBreak.length;
    document.getElementById('lsrSleep').textContent=sleeping.length;

    // Ticker
    updateTicker(students);

    // Top Focused (study_seconds / (1 + breaks_used) formula)
    const ranked=computeRank(students);
    if(ranked.length){
      const top=ranked[0];
      document.getElementById('tfName').textContent=top.name;
      document.getElementById('tfMeta').textContent=`HSC ${top.batch||''} · ${top.college||''}`;
      document.getElementById('tfTime').textContent=fmtCompact(top.study_seconds);
    }

    // Break people list
    const bpb=document.getElementById('breakPeopleBox');
    const bpl=document.getElementById('breakPeopleList');
    if(onBreak.length){
      bpb.classList.add('show');
      bpl.innerHTML=onBreak.map(s=>`<span class="bpb-chip">☕ ${escHtml(s.name)}</span>`).join('');
    } else { bpb.classList.remove('show'); }

    // Sleep people list
    const spb=document.getElementById('sleepPeopleBox');
    const spl=document.getElementById('sleepPeopleList');
    if(sleeping.length){
      spb.classList.add('show');
      spl.innerHTML=sleeping.map(s=>`<span class="spb-chip">😴 ${escHtml(s.name)}</span>`).join('');
    } else { spb.classList.remove('show'); }

    // Live students section
    renderBatchFilter(students);
    renderLiveStudents(students);

  } catch(_){}
}

/* Rank formula: study_seconds / (1 + breaks_used * 0.5) */
function computeRank(students){
  return [...students].sort((a,b)=>{
    const scoreA=a.study_seconds/(1+(a.breaks_used||0)*0.5);
    const scoreB=b.study_seconds/(1+(b.breaks_used||0)*0.5);
    return scoreB-scoreA;
  });
}

/* ═══ LEADERBOARD ═══ */
function setPeriod(days, btn){
  currentPeriod=days;
  document.querySelectorAll('.period-btn,.period-btn2').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  loadLeaderboard(days);
}

async function loadLeaderboard(days){
  const since=new Date(Date.now()-days*86400000).toISOString();
  try {
    // Aggregate from study_tracker_daily
    const rows=await safeFetch(`${SUPABASE_URL}/rest/v1/study_tracker_daily?study_date=gte.${since.slice(0,10)}&select=*,users(name,batch,college,premium)&order=total_seconds.desc&limit=50`);
    // Group by user
    const grouped={};
    (rows||[]).forEach(r=>{
      const phone=r.user_phone;
      if(!grouped[phone]){
        grouped[phone]={name:r.users?.name||'Student',batch:r.users?.batch,college:r.users?.college,premium:r.users?.premium||false,total_seconds:0,phone};
      }
      grouped[phone].total_seconds+=r.total_seconds||0;
    });
    const list=Object.values(grouped).sort((a,b)=>b.total_seconds-a.total_seconds);
    renderLeaderboard(list);
  } catch(_){
    // Fallback to live data
    renderLeaderboard(computeRank(allStudents).map(s=>({...s,total_seconds:s.study_seconds})));
  }
}

function renderLeaderboard(list){
  // Top 3
  const top3=document.getElementById('top3Section');
  if(!list.length){ top3.innerHTML=''; document.getElementById('rankList').innerHTML='<div style="text-align:center;padding:20px;color:var(--text-secondary);font-size:11px">এখনো কোনো ডেটা নেই</div>'; return; }

  const icons=['🥇','🥈','🥉'];
  const rankClasses=['rank1','rank2','rank3'];
  const crowns=['👑','🌟','⭐'];

  top3.innerHTML=list.slice(0,3).map((s,i)=>`
    <div class="top3-card ${rankClasses[i]}">
      ${i===0?'<div class="rank1-badge">TOP</div>':''}
      <div class="top3-crown">${crowns[i]}</div>
      <div class="top3-avatar">👤</div>
      <div class="top3-name">${escHtml(s.name)}</div>
      <div class="top3-batch">HSC ${escHtml(s.batch||'')}</div>
      <div class="top3-college">${escHtml(s.college||'')}</div>
      <div class="top3-time">${fmtCompact(s.total_seconds)}</div>
      ${s.premium?'<div style="font-size:8px;margin-top:2px;color:#F59E0B">⭐ Premium</div>':''}
    </div>
  `).join('');

  // 4th onwards
  const rankList=document.getElementById('rankList');
  if(list.length<=3){ rankList.innerHTML=''; return; }
  rankList.innerHTML=list.slice(3).map((s,i)=>buildRankCard(s,i+4,false)).join('');
}

/* ═══ LIVE STUDENTS ═══ */
function renderBatchFilter(students){
  const batches={};
  students.forEach(s=>{ const b=s.batch||'অন্যান্য'; batches[b]=(batches[b]||0)+1; });
  const el=document.getElementById('batchFilter');
  const keys=Object.keys(batches).sort();
  if(keys.length<=1){ el.innerHTML=''; return; }
  el.innerHTML=`<div class="bf-chip ${selectedBatch==='all'?'active':''}" onclick="filterBatch('all')">সবাই (${students.length})</div>`+
    keys.map(k=>`<div class="bf-chip ${selectedBatch===k?'active':''}" onclick="filterBatch('${escHtml(k)}')">${escHtml(k)} (${batches[k]})</div>`).join('');
}

function filterBatch(b){ selectedBatch=b; renderBatchFilter(allStudents); renderLiveStudents(allStudents); }

function renderLiveStudents(students){
  const filtered=selectedBatch==='all'?students:students.filter(s=>(s.batch||'অন্যান্য')===selectedBatch);
  const ranked=computeRank(filtered);
  const list=document.getElementById('liveStudentsList');
  if(!ranked.length){
    list.innerHTML=`<div style="text-align:center;padding:16px;color:var(--text-secondary);font-size:11px">এই মুহূর্তে কেউ পড়ছে না</div>`;
    return;
  }
  list.innerHTML=ranked.map((s,i)=>buildRankCard(s,i+1,true)).join('');
}

function buildRankCard(s,rank,showStatus){
  const isLive=s.status&&s.status!=='ended';
  const statusHtml=showStatus&&isLive?`
    <span class="r-status ${s.status==='break'?'r-status-break':s.status==='sleep'?'r-status-sleep':'r-status-study'}">
      <span class="r-status-dot"></span>
      ${s.status==='break'?'বিরতি':s.status==='sleep'?'ঘুম':'LIVE'}
    </span>
  `:'';
  const rankIcon=rank<=3?MEDALS[rank-1]:`<span style="font-size:10px;font-weight:800;color:var(--text-secondary)">${rank}</span>`;
  return `
    <div class="r-card ${rank===1?'rank1-card':''} ${isLive?'is-live':''}">
      ${rank===1?'<div class="rank1-glow"></div>':''}
      <div class="r-rank">${rankIcon}</div>
      <div class="r-photo">👤</div>
      <div class="r-info">
        <div class="r-name">${escHtml(s.name)}${s.premium?' ⭐':''}</div>
        <div class="r-meta">HSC ${escHtml(s.batch||'')} · ${escHtml(s.college||'')}</div>
      </div>
      <div class="r-right">
        <div class="r-time">${fmtCompact(s.total_seconds||s.study_seconds||0)}</div>
        <div class="r-breaks">☕ ${s.breaks_used||0}টি বিরতি</div>
        ${statusHtml}
        <button class="compare-btn" onclick="openCompare(${JSON.stringify(escHtml(s.name))},${JSON.stringify(escHtml(s.batch||''))},${JSON.stringify(escHtml(s.college||''))},${s.total_seconds||s.study_seconds||0},${s.breaks_used||0})">
          ⚡ তুলনা
        </button>
      </div>
    </div>
  `;
}

/* ═══ COMPARE ═══ */
let cmpTarget=null, cmpPeriod=1;

function openCompare(name,batch,college,secs,breaks){
  cmpTarget={name,batch,college,secs,breaks};
  cmpPeriod=1;
  document.getElementById('cmMeName').textContent=currentUser?.name||'তুমি';
  document.getElementById('cmMeMeta').textContent=`HSC ${currentUser?.batch||''}`;
  document.getElementById('cmThemName').textContent=name;
  document.getElementById('cmThemMeta').textContent=`HSC ${batch} · ${college}`;
  document.querySelectorAll('.cm-period-btn').forEach((b,i)=>b.classList.toggle('active',i===0));
  buildCompare(1);
  document.getElementById('compareModal').classList.add('show');
}

function closeCompare(){ document.getElementById('compareModal').classList.remove('show'); }

function setCmpPeriod(days,btn){
  cmpPeriod=days;
  document.querySelectorAll('.cm-period-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildCompare(days);
}

function buildCompare(days){
  if(!cmpTarget) return;
  // My data — use current session data for today, or stored
  const myStudy=studySecs; const myBreaks=breaksUsed;
  const theirStudy=cmpTarget.secs; const theirBreaks=cmpTarget.breaks;
  const maxSec=Math.max(myStudy,theirStudy,1);
  const meW=Math.round((myStudy/maxSec)*100);
  const thW=Math.round((theirStudy/maxSec)*100);
  const ahead=myStudy>=theirStudy;
  const diff=Math.abs(myStudy-theirStudy);

  document.getElementById('cmStats').innerHTML=`
    <div class="cm-stat-row">
      <div class="cm-stat-label">পড়ার সময়</div>
      <div class="cm-bar-wrap">
        <div class="cm-bar cm-bar-me" style="width:${meW}%"></div>
        <div class="cm-bar-val" style="color:var(--accent)">${fmtCompact(myStudy)}</div>
      </div>
    </div>
    <div class="cm-stat-row">
      <div class="cm-stat-label">${escHtml(cmpTarget.name)}</div>
      <div class="cm-bar-wrap">
        <div class="cm-bar cm-bar-them" style="width:${thW}%"></div>
        <div class="cm-bar-val" style="color:#818CF8">${fmtCompact(theirStudy)}</div>
      </div>
    </div>
    <div class="cm-stat-row">
      <div class="cm-stat-label">বিরতি</div>
      <div class="cm-bar-wrap" style="font-size:10px;font-weight:700;color:var(--text)">
        তুমি: ${myBreaks}টি &nbsp;|&nbsp; ${escHtml(cmpTarget.name)}: ${theirBreaks}টি
      </div>
    </div>
  `;

  const verdict=document.getElementById('cmVerdict');
  if(ahead){
    verdict.className='cm-verdict';
    verdict.innerHTML=`🎉 তুমি <b>${fmtCompact(diff)}</b> এগিয়ে আছো! এই ধারা বজায় রাখো — বিরতি কম নিলে rank আরো ভালো হবে।`;
  } else if(diff===0){
    verdict.className='cm-verdict';
    verdict.innerHTML=`🤝 সমান সমান! এখন একটু বেশি পড়লেই এগিয়ে যাবে।`;
  } else {
    verdict.className='cm-verdict behind';
    verdict.innerHTML=`💪 <b>${fmtCompact(diff)}</b> পিছিয়ে আছো। বিরতি কমাও এবং একটানা পড়ার session বাড়াও — তাহলে দ্রুত এগিয়ে যাবে।`;
  }
}

/* ═══ RESTORE SESSION ═══ */
function restoreSession(){
  const saved=loadState();
  if(!saved||(saved.mood!=='study'&&saved.mood!=='break'&&saved.mood!=='sleep')) return false;
  const elapsed=Math.floor((Date.now()-saved.savedAt)/1000);
  mood=saved.mood; paused=saved.paused||false; sessionId=saved.sessionId;
  breaksUsed=saved.breaksUsed||0;
  studySecs=saved.studySecs||0;
  breakSecs=saved.breakSecs||0;
  sleepSecs=saved.sleepSecs||0;
  // Add elapsed to active mood (unless paused)
  if(!paused){
    if(mood==='study') studySecs+=elapsed;
    else if(mood==='break'){ breakSecs+=elapsed; if(breakSecs>=MAX_BREAK_SEC){breakSecs=MAX_BREAK_SEC;} }
    else if(mood==='sleep') sleepSecs+=elapsed;
  }
  timerRunning=true;
  showTimerScreen();
  updateMoodButtons(); renderTimer(); saveState();
  if(paused){
    document.getElementById('ctrlPause').style.display='none';
    document.getElementById('ctrlResume').style.display='flex';
  }
  ticker=setInterval(tick,1000);
  renderLive(); startPolling();
  return true;
}

/* ═══ VISIBILITY CHANGE ═══ */
// আগে study mood-এ tab hidden হলেই timer auto-pause হয়ে যেত — page
// navigate করলে (যেমন history দেখতে গেলে) বা screen lock হলেও থেমে
// যেত। এখন কোনো mood-ই hide হওয়ার কারণে pause হয় না — background-এ
// গণনা চলতেই থাকে, এবং ফিরে আসার সময় elapsed সময় সব mood-এর জন্যই
// (study সহ) সঠিকভাবে sync করা হয়।
document.addEventListener('visibilitychange',()=>{
  if(document.hidden){
    saveState();
  } else {
    const saved=loadState();
    if(saved && timerRunning && !paused){
      const elapsed=Math.floor((Date.now()-saved.savedAt)/1000);
      if(elapsed<=0) return;
      if(mood==='study'){ studySecs=(saved.studySecs||0)+elapsed; }
      else if(mood==='break'){ breakSecs=(saved.breakSecs||0)+elapsed; if(breakSecs>=MAX_BREAK_SEC){ autoEndBreak(); return; } }
      else if(mood==='sleep'){ sleepSecs=(saved.sleepSecs||0)+elapsed; }
      renderTimer(); saveState();
    }
  }
});

/* ═══ INIT ═══ */
document.addEventListener('DOMContentLoaded',()=>{
  const saved=localStorage.getItem('atlas-theme');
  if(saved==='light'){isDarkMode=false;document.body.classList.add('light-mode');document.body.classList.remove('dark-mode');}
  try{currentUser=JSON.parse(localStorage.getItem('atlas-session'));}catch(_){currentUser=null;}
  if(!currentUser){location.replace('auth.html');return;}
  const restored=restoreSession();
  if(!restored) renderLive();
  loadLeaderboard(1);
  setInterval(renderLive,30000);
});

history.pushState(null,'',location.href);
window.addEventListener('popstate',()=>history.back());
</script>

<script src="global-nav.js"></script>
<script src="atlas-ui.js"></script>
</body>
</html>